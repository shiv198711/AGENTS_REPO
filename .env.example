# ==========================================================================
# CVI_ERROR_R_AUTO — Environment configuration
# --------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# ==========================================================================

# --- Runtime ---
HOST=0.0.0.0
PORT=8030
LOG_LEVEL=INFO

# --- LLM Provider ---
# aicore-anthropic | anthropic | mock
LLM_PROVIDER=aicore-anthropic
STUDIO_LLM_ENABLED=true
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=180

# --- SAP AI Core (Claude via Generative AI Hub) ---
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default
AICORE_DEPLOYMENT_ID=
AICORE_ANTHROPIC_VERSION=bedrock-2023-05-31

# --- Direct Anthropic API (optional fallback provider) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- SAP Backend Connectivity (mocked by default) ---
# All SAP backend interactions are abstracted through connectors.
# When real credentials are supplied they can be wired to pyrfc / OData.
SAP_ECC_HOST=
SAP_ECC_SYSNR=00
SAP_ECC_CLIENT=100
SAP_ECC_USER=
SAP_ECC_PASSWORD=

SAP_S4_HOST=
SAP_S4_SYSNR=00
SAP_S4_CLIENT=100
SAP_S4_USER=
SAP_S4_PASSWORD=

SAP_ODATA_BASE_URL=
SAP_CLOUD_CONNECTOR_LOCATION_ID=

# --- Feature toggles ---
ENABLE_REAL_RFC=false
ENABLE_REAL_SNOTE=false
ENABLE_REAL_TRANSPORT=false
ENABLE_SAP_GUI_AUTOMATION=false

# --- Security ---
APPROVAL_REQUIRED_FOR_PROD=true
AUDIT_LOG_ENABLED=true
RBAC_ENABLED=true

# --- Storage ---
DATA_DIR=data